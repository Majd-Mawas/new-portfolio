# Copy to .env.local for local development. In Netlify, configure environment
# variables with Functions scope and redeploy. Do not commit real credentials.
RESEND_API_KEY=
# A sender address on a domain verified in your Resend account.
CONTACT_FROM=
# Create a Turnstile widget allowing your actual .netlify.app/custom hostname.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional canonical URL override. Netlify's URL is used automatically otherwise.
SITE_URL=
